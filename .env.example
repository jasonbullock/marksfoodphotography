# Frontend
VITE_API_BASE_URL=http://localhost:5057/api

# Backend
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5057
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# Airtable
AIRTABLE_API_KEY=pat_your_airtable_token
AIRTABLE_BASE_ID=app_your_base_id
# Optional table-name overrides. Defaults preserve the current Airtable schema:
# Products -> Items, Shipments -> Receipts, Merchandise -> Receipt Entries.
# Set these only after the physical Airtable tables are renamed.
AIRTABLE_PRODUCTS_TABLE=Items
AIRTABLE_SHIPMENTS_TABLE=Receipts
AIRTABLE_MERCHANDISE_TABLE=Receipt Entries

# Receiving photo storage
# Set to r2 for permanent Cloudflare R2 storage. Set to local only for explicit development fallback.
RECEIVING_PHOTO_STORAGE=local
# Optional max upload size in bytes. Defaults to 12582912 when unset.
RECEIVING_PHOTO_MAX_BYTES=12582912
# Required when RECEIVING_PHOTO_STORAGE=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public, non-expiring asset base URL used by Airtable attachment ingestion.
R2_PUBLIC_BASE_URL=
