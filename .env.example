# Frontend
VITE_API_BASE_URL=http://localhost:5057/api

# Backend
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5057
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# Airtable
AIRTABLE_API_KEY=pat_your_airtable_token
AIRTABLE_BASE_ID=app_your_base_id
# Optional table-name overrides. Defaults match the canonical Airtable schema.
AIRTABLE_PRODUCTS_TABLE=Products
AIRTABLE_SHIPMENTS_TABLE=Shipments
AIRTABLE_MERCHANDISE_TABLE=Merchandise
AIRTABLE_WORK_ORDERS_TABLE=Work Orders

# Receiving photo storage
# Cloudflare R2 is the only supported image storage mode.
RECEIVING_PHOTO_STORAGE=r2
# Optional max upload size in bytes. Defaults to 12582912 when unset.
RECEIVING_PHOTO_MAX_BYTES=12582912
# Required for image upload and display URL resolution.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Asset base URL used by the API to resolve display URLs from stored R2 object keys.
R2_PUBLIC_BASE_URL=
